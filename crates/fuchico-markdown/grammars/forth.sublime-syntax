%YAML 1.2
---
# Port of @codemirror/legacy-modes/mode/forth.js (MIT).
name: Forth
scope: source.forth-port
contexts:
  main:
    - match: |-
        (?<!\S)\\(?:\s.*)?$
      scope: comment.line.backslash.forth
    - match: |-
        (?<!\S)\((?=\s|$)[^)\n]*\)?
      scope: comment.block.paren.forth
    - match: |-
        (?<!\S)\.\((?=\s|$)[^)\n]*\)?
      scope: string.quoted.other.forth
    - match: |-
        (?<!\S)(?:S"|\."|C")(?=\s|$)[^"\n]*"?
      scope: string.quoted.double.forth
    - match: |-
        (?i)(?<!\S)(?:VARIABLE|2VARIABLE|CONSTANT|2CONSTANT|CREATE|POSTPONE|VALUE|WORD)\s+\S+
      scope: variable.other.definition.forth
    - match: |-
        (?<!\S):\s+\S+
      scope: variable.other.definition.forth
    - match: |-
        (?i)(?<!\S)(?:'|\[')\s+\S+
      scope: support.function.forth
    - match: |-
        (?i)(?<!\S)(?:\]|:NONAME)(?!\S)
      scope: support.function.forth
    - match: |-
        (?i)(?<!\S)(?:INVERT|AND|OR|XOR|2\*|2\/|LSHIFT|RSHIFT|0=|=|0<|<|>|U<|MIN|MAX|2DROP|2DUP|2OVER|2SWAP|\?DUP|DEPTH|DROP|DUP|OVER|ROT|SWAP|>R|R>|R@|\+|\-|1\+|1\-|ABS|NEGATE|S>D|\*|M\*|UM\*|FM\/MOD|SM\/REM|UM\/MOD|\*\/|\*\/MOD|\/|\/MOD|MOD|HERE|,|@|!|CELL\+|CELLS|C,|C@|C!|CHARS|2@|2!|ALIGN|ALIGNED|\+!|ALLOT|CHAR|\[CHAR\]|\[|\]|BL|FIND|EXECUTE|IMMEDIATE|COUNT|LITERAL|STATE|;|DOES>|>BODY|EVALUATE|SOURCE|>IN|<#|#|#S|#>|HOLD|SIGN|BASE|>NUMBER|HEX|DECIMAL|FILL|MOVE|\.|CR|EMIT|SPACE|SPACES|TYPE|U\.|\.R|U\.R|ACCEPT|TRUE|FALSE|<>|U>|0<>|0>|NIP|TUCK|ROLL|PICK|2>R|2R@|2R>|WITHIN|UNUSED|MARKER|I|J|TO|COMPILE,|\[COMPILE\]|SAVE\-INPUT|RESTORE\-INPUT|PAD|ERASE|2LITERAL|DNEGATE|D\-|D\+|D0<|D0=|D2\*|D2\/|D<|D=|DMAX|DMIN|D>S|DABS|M\+|M\*\/|D\.|D\.R|2ROT|DU<|CATCH|THROW|FREE|RESIZE|ALLOCATE|CS\-PICK|CS\-ROLL|GET\-CURRENT|SET\-CURRENT|FORTH\-WORDLIST|GET\-ORDER|SET\-ORDER|PREVIOUS|SEARCH\-WORDLIST|WORDLIST|ALSO|ONLY|FORTH|DEFINITIONS|ORDER|\-TRAILING|\/STRING|SEARCH|COMPARE|CMOVE|CMOVE>|BLANK|SLITERAL)(?!\S)
      scope: support.function.forth
    - match: |-
        (?i)(?<!\S)(?:IF|ELSE|THEN|BEGIN|WHILE|REPEAT|UNTIL|RECURSE|\[IF\]|\[ELSE\]|\[THEN\]|\?DO|DO|LOOP|\+LOOP|UNLOOP|LEAVE|EXIT|AGAIN|CASE|OF|ENDOF|ENDCASE)(?!\S)
      scope: keyword.control.forth
    - match: |-
        (?<!\S)(?:[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?|0[xX][0-9a-fA-F]+)(?!\S)
      scope: constant.numeric.forth
    - match: |-
        (?<!\S)\S+
      scope: constant.language.forth
