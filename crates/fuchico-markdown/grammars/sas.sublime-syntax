%YAML 1.2
---
# Port of @codemirror/legacy-modes/mode/sas.js (MIT).
name: SAS
scope: source.sas
variables:
  all_builtin: '(?:libname|filename|options?)'
  all_def: '(?:nosource2|footnote|%sysfunc|pagesize|libname|%global|source2|pageno|title|%eval|%let|%put|page|ods)'
contexts:
  main:
    - include: common
    - match: '(?i)\b(proc)\b(?:(\s+)(\w+))?'
      captures:
        1: support.function.sas
        3: variable.other.special.sas
      push: proc
    - match: '(?i)\b(data)\b(?!\s*=)(?:(\s+)(\w+))?'
      captures:
        1: support.function.sas
        3: variable.other.special.sas
      push: datastep
    - match: '(?i)%(macro)\b(?:(\s+)(\w+))?'
      captures:
        0: support.function.sas
        3: variable.other.special.sas
      push: macro
    - include: everywhere
  everywhere:
    - match: '(?i)(?<![\w&%])(?:libname|filename|options?)\b'
      scope: support.function.sas
    - match: '(?i)(?<![\w&%])(?:title[1-9]?|footnote[1-9]?)\b'
      scope: variable.other.definition.sas
    - match: '(?i)(?<![\w&%])(?:ods|source2|nosource2|page|pageno|pagesize)\b|(?i)(?<![\w&])%(?:let|put|global|sysfunc|eval)\b'
      scope: variable.other.definition.sas
    - match: '(?i)&(?:systcpiphostname|syslogapplname|sysprocessname|syswarningtext|syscharwidth|syserrortext|sysmacroname|sysprocessid|sysstartname|sysencoding|syshostname|sysprocname|sysodspath|sysstartid|sysuserid|sysvlong4|sysbuffr|sysdate9|sysdevic|sysfilrc|sysindex|sysjobid|syslckrc|syslibrc|syspbuff|sysvlong|sysdate|sysinfo|syslast|sysmenv|sysncpu|sysparm|sysscpl|syssite|systime|syscmd|sysday|sysdmg|sysdsn|sysenv|syserr|sysmsg|sysscp|sysver|syscc|sysrc)\b'
      scope: variable.other.sas
    - match: '&\w+'
      scope: variable.other.sas
  common:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.sas
      push: block-comment
    - match: '^\s*\*.*$'
      scope: comment.line.sas
    - match: '"'
      push: dq-string
    - match: "'"
      push: sq-string
    - match: '\b0[xX][0-9a-fA-F]+\b|\b(?:\d+\.?\d*|\.\d+)(?:[eE][\-+]?\d+)?'
      scope: constant.numeric.sas
    - match: '<=|>=|!=|<>'
      scope: keyword.operator.sas
    - match: '\b(?:eq|lt|le|gt|ge|in|ne|or)(?= )'
      scope: keyword.operator.sas
    - match: '[=():,{}.*<>+\-/^\[\]]'
      scope: keyword.operator.sas
  keyword-ops:
    - match: '(?i)\b(?:and|not)\b'
      scope: keyword.operator.sas
  datastep:
    - include: common
    - match: '(?i)\brun\s*;'
      scope: support.function.sas
      pop: true
    - match: '(?i)\b(?:data|run)\b'
      scope: support.function.sas
