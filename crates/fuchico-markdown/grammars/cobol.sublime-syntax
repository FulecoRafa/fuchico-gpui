# Port of @codemirror/legacy-modes/mode/cobol.js (MIT).
name: Cobol
scope: source.cobol
contexts:
  main:
    # Sequence-number area, comment indicator and identification area.
    - match: '^(.{6})(\*.*)$'
      captures:
        1: variable.other.definition.cobol
        2: comment.line.cobol
    - match: '^[^\n]{1,6}'
      scope: variable.other.definition.cobol
    - match: '(?<=^.{72}).*$'
      scope: markup.heading.cobol
    - match: '"'
      scope: string.quoted.double.cobol
      push: dq_string
    - match: "'"
      scope: string.quoted.single.cobol
      push: sq_string
    - match: '\.'
      scope: markup.underline.link.cobol
    - match: '(?i)(?<![\w*+\-])0x[0-9a-f]*'
      scope: constant.numeric.cobol
    - match: '(?i)(?<![\w*+\-])[+-]?\d+(?:\.\d*)?(?:e[+-]?\d*)?'
      scope: constant.numeric.cobol
