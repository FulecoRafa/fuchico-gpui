%YAML 1.2
---
# Port of @codemirror/legacy-modes/mode/eiffel.js (MIT).
name: Eiffel
scope: source.eiffel
contexts:
  main:
    - match: '"'
      scope: string.quoted.double.eiffel
      push: dq_string
    - match: "'"
      scope: string.quoted.single.eiffel
      push: sq_string
    - match: '--.*$'
      scope: comment.line.eiffel
    - match: ':='
      scope: keyword.operator.eiffel
    - match: '[=+\-/*^%<>~]+'
      scope: keyword.operator.eiffel
    - match: '(?<![\w])(?:note|across|when|variant|until|unique|undefine|then|strip|select|retry|rescue|require|rename|reference|redefine|prefix|once|old|obsolete|loop|local|like|is|inspect|infix|include|if|frozen|from|external|export|ensure|end|elseif|else|do|creation|create|check|alias|agent|separate|invariant|inherit|indexing|feature|expanded|deferred|class|Void|True|Result|Precursor|False|Current|attached|detachable|as|and|implies|not|or)(?![\w?!])'
      scope: keyword.control.eiffel
    - match: '(?<![\w])[A-Z][A-Z_0-9]*(?![\w?!])'
      scope: entity.name.tag.eiffel
    - match: '(?<![\w])0[bB][01]+(?![\w?!])'
      scope: constant.numeric.eiffel
    - match: '(?<![\w])0[cC][0-7]+(?![\w?!])'
      scope: constant.numeric.eiffel
    - match: '(?<![\w])0[xX][a-fA-F0-9]+(?![\w?!])'
      scope: constant.numeric.eiffel
    - match: '(?<![\w])(?:[0-9]+\.[0-9]*|[0-9]*\.[0-9]+)(?![\w?!])'
      scope: constant.numeric.eiffel
    - match: '(?<![\w])[0-9]+(?![\w?!])'
      scope: constant.numeric.eiffel
    - match: '[a-zA-Z_0-9]+[?!]?'
      scope: variable.other.eiffel
  dq_string:
    - meta_scope: string.quoted.double.eiffel
    - match: '%.'
    - match: '"'
      pop: true
  sq_string:
    - meta_scope: string.quoted.single.eiffel
    - match: '%.'
    - match: "'"
      pop: true
