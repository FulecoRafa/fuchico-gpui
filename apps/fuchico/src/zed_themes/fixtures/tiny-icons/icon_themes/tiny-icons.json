{
  "$schema": "https://zed.dev/schema/icon_themes/v0.3.0.json",
  "name": "Tiny Icons",
  "author": "Fuchico tests",
  "themes": [
    {
      "name": "Tiny Icons",
      "appearance": "dark",
      "directory_icons": {
        "collapsed": "./icons/folder.svg",
        "expanded": "./icons/folder-open.svg"
      },
      "named_directory_icons": {
        "templates": {
          "collapsed": "./icons/folder-templates.svg",
          "expanded": "./icons/folder-templates-open.svg"
        }
      },
      "file_stems": { "README.md": "readme" },
      "file_suffixes": { "md": "markdown", "excalidraw": "drawing", "bad": "broken" },
      "file_icons": {
        "default": { "path": "./icons/file.svg" },
        "markdown": { "path": "./icons/markdown.svg" },
        "readme": { "path": "./icons/readme.svg" },
        "drawing": { "path": "./icons/drawing.svg" },
        "broken": { "path": "./icons/broken.svg" },
        "missing": { "path": "./icons/missing.svg" }
      }
    }
  ]
}
