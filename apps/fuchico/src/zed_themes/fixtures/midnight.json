{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Midnight",
  "author": "Fuchico tests (hand-made fixture)",
  "themes": [
    {
      "name": "Midnight",
      "appearance": "dark",
      "style": {
        // Zed accepts comments and trailing commas in theme files.
        "background": "#0b1020ff",
        "editor.background": "#0d1326ff",
        "editor.foreground": "#d6deebff",
        "text": "#d6deebff",
        "text.muted": "#7f8ba8ff",
        "text.accent": "#82aaffff",
        "border": "#1d2742ff",
        "border.variant": "#18213aff",
        "border.focused": "#3d5a9eff",
        "panel.background": "#0a0f1eff",
        "element.background": "#16203aff",
        "element.selected": "#22305aff",
        "error": "#ff5874ff",
        "warning": "#ffcb6bff",
        "success": "#addb67ff",
        "players": [{ "cursor": "#ffcc00ff", "selection": "#82aaff40" }],
        "syntax": {
          "keyword": { "color": "#c792eaff", "font_style": "italic" },
          "string": { "color": "#ecc48dff" },
          "number": { "color": "#f78c6cff" },
          "function": { "color": "#82aaffff" },
          "type": { "color": "#ffcb8bff" },
          "comment": { "color": "#637777ff", "font_style": "italic" },
        },
      },
    },
  ],
}
